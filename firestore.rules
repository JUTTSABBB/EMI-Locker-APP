rules_version = '2';
// Only signed-in Ozzun staff can read/write business data from the dashboard.
// Device check-ins and lock commands are written ONLY by the Cloudflare Worker
// (via the Admin REST API, which bypasses these rules) — clients can never write them.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function staffDoc() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data; }
    function isStaff()  { return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && staffDoc().active == true; }
    function isAdmin()  { return isStaff() && staffDoc().role == 'admin'; }

    // Financed phone accounts
    match /accounts/{id} {
      allow read:          if isStaff();
      allow create, update:if isStaff();
      allow delete:        if isAdmin();
    }

    // Team members (only admins manage the team; a member can read the roster)
    match /staff/{uid} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    // Installment payment ledger
    match /payments/{id} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // Device runtime state (lock flags, check-ins) — server-only, never client-writable
    match /devices/{id} {
      allow read:  if isStaff();
      allow write: if false;
    }

    // Default deny
    match /{document=**} { allow read, write: if false; }
  }
}
